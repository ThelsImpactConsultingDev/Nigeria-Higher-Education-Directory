#!/usr/bin/env python3
"""Turn the source workbook into the compact JSON payload the page embeds.

    python scripts/build_data.py [--source data/source.xlsx] [--out build/data.json]
"""
import argparse, json, os, sys
import pandas as pd

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from clean import SHEETS, COMING_SOON, load_category, dedupe, compact


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--source', default='data/source.xlsx')
    ap.add_argument('--out', default='build/data.json')
    args = ap.parse_args()

    if not os.path.exists(args.source):
        sys.exit(f"ERROR: source workbook not found: {args.source}")

    xl = pd.ExcelFile(args.source)
    missing = [c['sheet'] for c in SHEETS.values() if c['sheet'] not in xl.sheet_names]
    if missing:
        sys.exit("ERROR: workbook is missing required sheet(s):\n  " +
                 "\n  ".join(missing) +
                 "\n\nSheets found:\n  " + "\n  ".join(xl.sheet_names))

    payload, total = {}, 0
    print(f"{'CATEGORY':<14}{'RAW':>7}{'DROPPED':>9}{'DUPES':>7}{'FINAL':>8}{'INSTS':>7}")
    for key in SHEETS:
        rows, dropped, raw = load_category(xl, key)
        final = dedupe(rows)
        insts = len(set(r['institution'] for r in final))
        print(f"{key:<14}{raw:>7}{dropped:>9}{len(rows)-len(final):>7}{len(final):>8}{insts:>7}")
        payload[key] = compact(final)
        total += len(final)

    for key in COMING_SOON:
        payload[key] = None          # null -> UI renders "coming soon"
        print(f"{key:<14}{'-':>7}{'-':>9}{'-':>7}{'-':>8}{'-':>7}  (coming soon)")

    print(f"{'TOTAL':<14}{'':>7}{'':>9}{'':>7}{total:>8}")

    os.makedirs(os.path.dirname(args.out) or '.', exist_ok=True)
    js = json.dumps(payload, separators=(',', ':'), ensure_ascii=False)
    with open(args.out, 'w', encoding='utf-8') as f:
        f.write(js)
    print(f"\nwrote {args.out}  ({len(js)/1024/1024:.2f} MB)")


if __name__ == '__main__':
    main()
